// use prisma-8

model Company {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  address     String?
  logoUrl     String?
  boats       Boat[]
  trips       Trip[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Boat {
  id          String   @id @default(uuid())
  name        String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  capacity    Int
  status      String   @default("ACTIVE")
  trips       Trip[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Port {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  city             String
  departureRoutes  Route[]  @relation("DeparturePort")
  arrivalRoutes    Route[]  @relation("ArrivalPort")
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()
}

model Route {
  id                  String   @id @default(uuid())
  originPortId        String
  originPort          Port     @relation("DeparturePort", fields: [originPortId], references: [id], onDelete: Restrict)
  destinationPortId   String
  destinationPort     Port     @relation("ArrivalPort", fields: [destinationPortId], references: [id], onDelete: Restrict)
  distanceKm          Float?
  estimatedMinutes    Int?
  trips               Trip[]
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()
}

model Trip {
  id              String   @id @default(uuid())
  code            String?
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  boatId          String
  boat            Boat     @relation(fields: [boatId], references: [id], onDelete: Restrict)
  routeId         String
  route           Route    @relation(fields: [routeId], references: [id], onDelete: Restrict)
  departureTime   TimestamptzString
  arrivalTime     TimestamptzString?
  pricePerSeat    Int
  availableSeats  Int
  status          String   @default("SCHEDULED")
  bookings        Booking[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  fullName    String
  phone       String?
  role        String   @default("passenger")
  companyId   String?
  bookings    Booking[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Booking {
  id             String    @id @default(uuid())
  reference      String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tripId         String
  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Restrict)
  seatsCount     Int       @default(1)
  totalAmount    Int
  status         String    @default("PENDING")
  paymentStatus  String    @default("UNPAID")
  tickets        Ticket[]
  payments       Payment[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Ticket {
  id             String   @id @default(uuid())
  ticketNumber   String   @unique
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passengerName  String
  cinOrPassport  String?
  seatNumber     String?
  status         String   @default("VALID")
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Payment {
  id             String    @id @default(uuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount         Int
  provider       String
  reference      String?
  status         String    @default("PENDING")
  paidAt         TimestamptzString?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}
