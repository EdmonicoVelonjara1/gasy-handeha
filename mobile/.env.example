# Copy to `.env` and fill in from the Supabase dashboard:
# https://supabase.com/dashboard/<project-ref>/settings/api
#
# The EXPO_PUBLIC_ prefix is required: the Expo CLI inlines matching variables
# into the JS bundle at build time. Anything with this prefix is public — never
# put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
